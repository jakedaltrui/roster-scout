table 'Scoped Pitching'
	column security_key
		dataType: string
		sourceColumn: security_key
	column statistic_scope_id
		dataType: string
		sourceColumn: statistic_scope_id
	column player_team_season_id
		dataType: string
		sourceColumn: player_team_season_id
	column opponent_at_bats
		dataType: int64
		sourceColumn: opponent_at_bats
	column hits_allowed
		dataType: int64
		sourceColumn: hits_allowed
	column innings_outs
		dataType: int64
		sourceColumn: innings_outs
	column earned_runs
		dataType: int64
		sourceColumn: earned_runs
	column walks
		dataType: int64
		sourceColumn: walks
	column strikeouts
		dataType: int64
		sourceColumn: strikeouts
	column home_runs_allowed
		dataType: int64
		sourceColumn: home_runs_allowed
	column batters_faced
		dataType: int64
		sourceColumn: batters_faced
	measure 'Opponent AVG' = DIVIDE(SUM('Scoped Pitching'[hits_allowed]), SUM('Scoped Pitching'[opponent_at_bats]))
		formatString: 0.000
	measure ERA = DIVIDE(27 * SUM('Scoped Pitching'[earned_runs]), SUM('Scoped Pitching'[innings_outs]))
		formatString: 0.00
	measure WHIP = DIVIDE(3 * (SUM('Scoped Pitching'[walks]) + SUM('Scoped Pitching'[hits_allowed])), SUM('Scoped Pitching'[innings_outs]))
		formatString: 0.00
	measure 'K/9' = DIVIDE(27 * SUM('Scoped Pitching'[strikeouts]), SUM('Scoped Pitching'[innings_outs]))
		formatString: 0.00
	measure 'BB/9' = DIVIDE(27 * SUM('Scoped Pitching'[walks]), SUM('Scoped Pitching'[innings_outs]))
		formatString: 0.00
	measure 'H/9' = DIVIDE(27 * SUM('Scoped Pitching'[hits_allowed]), SUM('Scoped Pitching'[innings_outs]))
		formatString: 0.00
	measure 'HR/9' = DIVIDE(27 * SUM('Scoped Pitching'[home_runs_allowed]), SUM('Scoped Pitching'[innings_outs]))
		formatString: 0.00
	measure 'K/BB' = DIVIDE(SUM('Scoped Pitching'[strikeouts]), SUM('Scoped Pitching'[walks]))
		formatString: 0.00
	measure 'K%' = DIVIDE(SUM('Scoped Pitching'[strikeouts]), SUM('Scoped Pitching'[batters_faced]))
		formatString: 0.0%
	measure 'BB%' = DIVIDE(SUM('Scoped Pitching'[walks]), SUM('Scoped Pitching'[batters_faced]))
		formatString: 0.0%
	partition 'Scoped Pitching' = m
		mode: import
		source =
			let Source = PostgreSQL.Database(RosterScoutDatabaseServer, RosterScoutDatabaseName), View = Source{[Schema="public",Item="pbi_scoped_pitching"]}[Data] in View
