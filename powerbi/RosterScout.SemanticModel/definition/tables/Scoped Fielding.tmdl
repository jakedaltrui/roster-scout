table 'Scoped Fielding'
	column security_key
		dataType: string
		sourceColumn: security_key
	column statistic_scope_id
		dataType: string
		sourceColumn: statistic_scope_id
	column player_team_season_id
		dataType: string
		sourceColumn: player_team_season_id
	column putouts
		dataType: int64
		sourceColumn: putouts
	column assists
		dataType: int64
		sourceColumn: assists
	column errors
		dataType: int64
		sourceColumn: errors
	column total_chances
		dataType: int64
		sourceColumn: total_chances
	measure 'Fielding %' = DIVIDE(SUM('Scoped Fielding'[putouts]) + SUM('Scoped Fielding'[assists]), SUM('Scoped Fielding'[total_chances]))
		formatString: 0.000
	partition 'Scoped Fielding' = m
		mode: import
		source =
			let Source = PostgreSQL.Database(RosterScoutDatabaseServer, RosterScoutDatabaseName), View = Source{[Schema="public",Item="pbi_scoped_fielding"]}[Data] in View
