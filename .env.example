# Safe loopback development-only defaults. Copy to .env only if your process
# manager loads it. The checked-in PostgreSQL and Redis credentials in
# compose.yaml must never be used for remote or production services.
PORT=5050
ROSTER_SCOUT_CACHE_DIR=.cache
SCRAPE_RATE_LIMIT=10
SCRAPE_RATE_WINDOW_SECONDS=600
BROWSERLESS_CAPACITY_BACKEND=local
BROWSERLESS_CAPACITY_NAMESPACE=roster-scout-browserless-account
BROWSERLESS_ACCOUNT_MAX_SESSIONS=2
CELERY_WORKER_CONCURRENCY=1
REPORT_JOB_MAX_ATTEMPTS=3
REPORT_DISPATCH_POLL_SECONDS=5
REPORT_DISPATCH_LEASE_SECONDS=60
REPORT_QUEUED_REDISPATCH_SECONDS=300
REPORT_RUNNING_STALE_SECONDS=1800
FAILURE_EVIDENCE_RETENTION_DAYS=30
REPORT_SCHEMA_VERSION=schema-1
NCAA_PARSER_VERSION=parser-1

# Add secrets only to your untracked .env or hosting provider's secret store.
# External deployments must inject authenticated, TLS-protected DATABASE_URL
# and CELERY_BROKER_URL values; never expose the Compose services remotely.
BROWSERLESS_TOKEN=
NCAA_BROWSER_PROVIDER=browserless
DATABASE_URL=
CELERY_BROKER_URL=
