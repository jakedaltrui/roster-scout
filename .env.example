# Safe local defaults. Copy to .env only if your process manager loads it.
PORT=5050
ROSTER_SCOUT_CACHE_DIR=.cache
SCRAPE_RATE_LIMIT=10
SCRAPE_RATE_WINDOW_SECONDS=600
BROWSERLESS_MAX_SESSIONS=2

# Add secrets only to your untracked .env or hosting provider's secret store.
BROWSERLESS_TOKEN=
NCAA_BROWSER_PROVIDER=browserless
